{
  "name": "aria-ex1",
  "version": "0.2.0",
  "description": "Execution-first workspace system: CODEMAP/STITCH, tiered /distill, edit-time Rule 22 hooks, and local workspace_index.sqlite for search and execution state. Claude, Cursor, and Codex compatible. Run /setup then /setup-db.",
  "author": {
    "name": "Mike Prasad"
  },
  "homepage": "https://github.com/nrek/aria-ex1",
  "repository": "https://github.com/nrek/aria-ex1",
  "license": "CC-BY-NC-SA-4.0",
  "keywords": [
    "codemap",
    "execution-first",
    "task-distillation",
    "full-stack",
    "hooks",
    "enforcement"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/bin/pre-edit-check.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/bin/pre-explore-codemap-check.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/bin/post-edit-check.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
