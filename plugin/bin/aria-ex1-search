#!/usr/bin/env python3
"""FTS search over ARIA-EX1 workspace index."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

_PLUGIN = Path(__file__).resolve().parents[1]
if str(_PLUGIN) not in sys.path:
    sys.path.insert(0, str(_PLUGIN))

from workspace_knowledge import db  # noqa: E402
from workspace_knowledge.paths import find_workspace_root, resolve_db_path  # noqa: E402
from workspace_knowledge.search import knowledge_search  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description="Search workspace index")
    parser.add_argument("query", help="Search terms")
    parser.add_argument("--project", help="Filter by project slug")
    parser.add_argument("--kind", help="Document kind filter")
    parser.add_argument("--status", dest="plan_status", help="Plan status filter")
    parser.add_argument("--limit", type=int, default=15)
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    root = find_workspace_root()
    with db.connect(resolve_db_path(root)) as conn:
        wid = db.ensure_workspace(conn, root)
        results = knowledge_search(
            conn,
            query=args.query,
            workspace_id=wid,
            project=args.project,
            kind=args.kind,
            plan_status=args.plan_status,
            limit=args.limit,
        )

    if args.json:
        print(json.dumps(results, indent=2))
    else:
        for r in results:
            print(f"{r['kind']:10} {r.get('project') or '-':20} {r['path']}")
            if r.get("snippet"):
                print(f"  {r['snippet']}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
