#!/usr/bin/env python3
"""Execution item status workflow for ARIA-EX1."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

_PLUGIN = Path(__file__).resolve().parents[1]
if str(_PLUGIN) not in sys.path:
    sys.path.insert(0, str(_PLUGIN))

from workspace_knowledge import db, execution  # noqa: E402
from workspace_knowledge.paths import find_workspace_root, resolve_db_path  # noqa: E402

VALID_STATUS = frozenset(
    {
        "draft",
        "needs_clarification",
        "ready",
        "in_progress",
        "blocked",
        "qa_ready",
        "done",
        "deferred",
        "rejected",
    }
)


def main() -> int:
    parser = argparse.ArgumentParser(description="ARIA-EX1 execution items")
    sub = parser.add_subparsers(dest="cmd", required=True)

    list_p = sub.add_parser("list")
    list_p.add_argument("--status", choices=sorted(VALID_STATUS))
    list_p.add_argument("--json", action="store_true")

    get_p = sub.add_parser("get")
    get_p.add_argument("id")
    get_p.add_argument("--json", action="store_true")

    for name in ("start", "block", "qa", "done", "reject", "defer"):
        p = sub.add_parser(name)
        p.add_argument("id")
        p.add_argument("--reason", default="")

    args = parser.parse_args()
    root = find_workspace_root()

    with db.connect(resolve_db_path(root)) as conn:
        wid = db.ensure_workspace(conn, root)

        if args.cmd == "list":
            rows = execution.list_execution_items(
                conn, workspace_id=wid, status=args.status
            )
            if args.json:
                print(json.dumps(rows, indent=2))
            else:
                for r in rows:
                    print(f"{r['id']}  {r['status']:18}  {r['title']}")
            return 0

        if args.cmd == "get":
            row = execution.get_execution_item(conn, args.id)
            if not row:
                print("not found", file=sys.stderr)
                return 1
            print(json.dumps(dict(row), indent=2) if args.json else row)
            return 0

        status_map = {
            "start": "in_progress",
            "block": "blocked",
            "qa": "qa_ready",
            "done": "done",
            "reject": "rejected",
            "defer": "deferred",
        }
        new_status = status_map[args.cmd]
        ok = execution.set_execution_status(conn, args.id, new_status)
        if not ok:
            print("not found", file=sys.stderr)
            return 1
        if getattr(args, "reason", ""):
            db.log_index_event(
                conn,
                f"exec_{args.cmd}",
                path=args.id,
                message=args.reason,
            )
        print(f"{args.id} -> {new_status}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
