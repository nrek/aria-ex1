#!/usr/bin/env python3
"""Compact execution context from workspace index."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

_PLUGIN = Path(__file__).resolve().parents[1]
if str(_PLUGIN) not in sys.path:
    sys.path.insert(0, str(_PLUGIN))

from workspace_knowledge import db  # noqa: E402
from workspace_knowledge.paths import find_workspace_root, resolve_db_path  # noqa: E402
from workspace_knowledge.search import build_context  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description="Load compact agent context")
    parser.add_argument("--group", help="Repo group / project slug")
    parser.add_argument("--project", help="Alias for --group")
    parser.add_argument("--hours", type=int, default=72)
    parser.add_argument("--task", dest="linear_task_id", help="Linear task id e.g. CXL-123")
    parser.add_argument("--execution-item", help="Execution item id")
    parser.add_argument("--json", action="store_true", default=True)
    args = parser.parse_args()

    root = find_workspace_root()
    with db.connect(resolve_db_path(root)) as conn:
        wid = db.ensure_workspace(conn, root)
        ctx = build_context(
            conn,
            workspace_id=wid,
            project=args.project or args.group,
            group=args.group,
            hours=args.hours,
            linear_task_id=args.linear_task_id,
        )
        if args.execution_item:
            row = conn.execute(
                "SELECT * FROM execution_items WHERE id = ? AND workspace_id = ?",
                (args.execution_item, wid),
            ).fetchone()
            if row:
                ctx["execution_item"] = dict(row)

    print(json.dumps(ctx, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
